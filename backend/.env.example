# FeedbackAI backend configuration. Copy to backend/.env and fill in the secrets.
# Generate secrets with: openssl rand -hex 32
NODE_ENV=development
PORT=5002

# MySQL (shared 8.0.46 server on 3307, separate database; see docs/00_DECISIONS.md §2)
DB_HOST=127.0.0.1
DB_PORT=3307
DB_USER=feedbackai_app
DB_PASSWORD=change-me
DB_NAME=feedback_ai_db
DB_NAME_TEST=feedback_ai_test_db

# Auth
JWT_SECRET=change-me-to-a-long-random-string
BCRYPT_COST=12
CORS_ORIGIN=http://localhost:5174

# AI sentiment service (FastAPI, bound to 127.0.0.1)
AI_SERVICE_URL=http://127.0.0.1:8001
AI_INTERNAL_TOKEN=change-me-shared-secret
